# ==============================================================================
# Executive Threat Advisory Agent Configuration (Vertex AI + Cloud Run MCP)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Cloud & Vertex AI Platform Settings
# ------------------------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_API_USE_CLIENT_CERTIFICATE=false
SECOPS_AGENT_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. Deployment & Service Account Settings
# ------------------------------------------------------------------------------
DISPLAY_NAME=exec_briefing_agent
SA_NAME=exec-briefing-agent-sa
MCP_PROJECT_ID=your-mcp-project-id

# ------------------------------------------------------------------------------
# 3. Remote Cloud Run MCP Server Settings
# ------------------------------------------------------------------------------
GTI_SERVICE_NAME=mcp-gti-mcp-server
SECOPS_SERVICE_NAME=mcp-secops-mcp-server
GTI_MCP_URL=https://<YOUR_GTI_SERVICE_URL>/mcp
SECOPS_MCP_URL=https://<YOUR_SECOPS_SERVICE_URL>/mcp


# ------------------------------------------------------------------------------
# 4. Telemetry & Observability
# ------------------------------------------------------------------------------
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=true
